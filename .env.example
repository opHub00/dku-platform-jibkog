# .env 파일로 복사해서 값을 넣어요(.env는 git에 올라가지 않아요).
# 어떤 키에도 VITE_ 접두사를 붙이지 마세요. 붙이면 브라우저 번들에 키가 노출돼요.
# 키가 없거나 호출이 실패하면(무료 한도 초과 429 포함) 화면은 규칙 기반 데모 모드로 동작해요.

# AI 공급자: gemini(기본) 또는 anthropic
AI_PROVIDER=gemini

# Google Gemini API 키와 모델. 모델은 무료 등급에서 쓸 수 있는 Flash 계열로 두세요.
# 사용할 수 있는 모델 이름은 Google AI Studio 가격·모델 문서에서 확인해요(바뀌면 이 값만 고치면 돼요).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# AI_PROVIDER=anthropic일 때만 써요.
ANTHROPIC_API_KEY=

# 네이버 검색 API(뉴스) 키. 맞춤 뉴스(/api/news)에 써요.
# 둘 중 하나라도 없으면 미리 준비한 샘플 뉴스로 동작하고 화면에 "샘플 뉴스"라고 표시해요.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 청약홈 분양정보(공공데이터포털)와 카카오 주소 검색 REST 키. 둘 다 서버에서만 읽어요.
# 둘 중 하나라도 없으면 청약 카탈로그는 fixture를 사용합니다.
DATA_GO_KR_SERVICE_KEY=
KAKAO_REST_API_KEY=
